- content_for :head do
  %link{rel: "preconnect", href: "https://fonts.googleapis.com"}
  %link{rel: "stylesheet", href: "https://fonts.googleapis.com/css2?family=Source+Serif+4:opsz,wght@8..60,500;8..60,600&display=swap"}

.max-w-2xl.mx-auto.py-1.px-4

  .mb-6.py-4
    %h1.text-3xl.font-bold Your Profile
    %p.profile-subtitle This is how other writers will see you.

  .profile-card
    .profile-layout
      .profile-avatar-col
        .avatar-upload
          .avatar-circle
            %svg.avatar-icon{width: "48", height: "48", viewBox: "0 0 24 24", fill: "none", stroke: "currentColor", "stroke-width": "1.6", "stroke-linecap": "round", "stroke-linejoin": "round"}
              %circle{cx: "12", cy: "8", r: "4"}
              %path{d: "M4 20c0-4 3.6-6.5 8-6.5s8 2.5 8 6.5"}
          %label.avatar-edit-btn{for: "avatar-upload-input", title: "Upload photo"}
            %svg{width: "16", height: "16", viewBox: "0 0 24 24", fill: "none", stroke: "currentColor", "stroke-width": "2", "stroke-linecap": "round", "stroke-linejoin": "round"}
              %path{d: "M4 8h3l1.5-2h7L17 8h3a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V9a1 1 0 0 1 1-1z"}
              %circle{cx: "12", cy: "13", r: "3.5"}
          %input#avatar-upload-input.sr-only{type: "file", accept: "image/*"}
        %span.avatar-hint Click to upload a photo

      .profile-fields-col
        .profile-field
          %label.profile-label{for: "profile-name"} Name
          %input#profile-name.profile-input{type: "text", placeholder: "Your full name"}

        .profile-field
          %label.profile-label{for: "profile-bio"} Bio
          %textarea#profile-bio.profile-input.profile-textarea{rows: 6, placeholder: "Tell your writing buddies a bit about yourself..."}

    .profile-actions
      %button.save-profile-btn{type: "button"} Save Profile
