.landing-hero
  .landing-content
    %h1.hero-title Write Daily. Critique Daily. Grow Together.
    %p.hero-subtitle
      Writing Buddy find you fellow writers to pair with for short sprints, say 5 to 7 days.
      Every day you write something brief but meaningful to you, and then critique your buddy's piece.
      No solo grinding — just a small group of people holding each other to it.

    .cta-buttons
      - if account_signed_in?
        = link_to "Go to Dashboard", posts_path, class: "cta-primary"
      - else
        = link_to "Get Started Free", new_account_session_path, class: "cta-primary"
        = link_to "See How It Works", "#how-it-works", class: "cta-secondary"

